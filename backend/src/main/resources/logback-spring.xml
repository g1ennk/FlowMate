<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Spring 프로파일 식별 -->
    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="flowmate-backend"/>
    <springProperty scope="context" name="profile" source="spring.profiles.active" defaultValue="default"/>

    <!-- local 프로파일: 사람이 읽기 좋은 텍스트 -->
    <springProfile name="local">
        <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{trace_id:-},%X{span_id:-}] %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>
    </springProfile>

    <!-- dev/prod: JSON 구조화 로그 (Loki에서 파싱) -->
    <springProfile name="dev,prod">
        <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <includeMdcKeyName>trace_id</includeMdcKeyName>
                <includeMdcKeyName>span_id</includeMdcKeyName>
                <includeMdcKeyName>trace_flags</includeMdcKeyName>
                <customFields>{"app":"${appName}","env":"${profile}"}</customFields>
                <fieldNames>
                    <timestamp>timestamp</timestamp>
                    <message>message</message>
                    <thread>thread</thread>
                    <logger>logger</logger>
                    <level>level</level>
                    <levelValue>[ignore]</levelValue>
                    <version>[ignore]</version>
                </fieldNames>
            </encoder>
        </appender>
    </springProfile>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>

    <!-- 도메인 로거 레벨 -->
    <logger name="kr.io.flowmate" level="${LOG_LEVEL_APP:-INFO}"/>
    <logger name="org.springframework.security" level="WARN"/>
    <logger name="org.hibernate.SQL" level="${LOG_LEVEL_SQL:-INFO}"/>
</configuration>
