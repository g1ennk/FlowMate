{
  "title": "FlowMate Backend Overview",
  "description": "RED + Saturation 한 화면. 매일 보는 1차 대시보드. SSE/Auth 같은 도메인 특수성 분리, SLO 임계치 시각화.",
  "tags": ["flowmate", "backend", "overview"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["10s", "30s", "1m", "5m", "15m", "30m", "1h"],
    "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d"]
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "custom",
        "query": "dev, prod",
        "current": { "text": "prod", "value": "prod" },
        "options": [
          { "text": "dev", "value": "dev", "selected": false },
          { "text": "prod", "value": "prod", "selected": true }
        ],
        "includeAll": false,
        "multi": false
      },
      {
        "name": "datasource_prom",
        "label": "Prometheus DS",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "grafanacloud-prom", "value": "grafanacloud-prom" },
        "hide": 2
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "🎯 Overview — 지금 잘 작동하나?",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "id": 100
    },
    {
      "type": "stat",
      "title": "Total RPS",
      "description": "사용자 입장 RPS (actuator 노이즈 제외). Spring Boot 자동 메트릭의 sum(rate(http_server_requests_seconds_count)).",
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{environment=\"$env\", uri!~\"/actuator.*\"}[5m]))",
          "instant": false
        }
      ],
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Error Rate %",
      "description": "5xx 비율. SLO 위반 임계: warning 0.5%, critical 2%.",
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(http_server_requests_seconds_count{environment=\"$env\", status=~\"5..\"}[5m])) OR vector(0)) / clamp_min(sum(rate(http_server_requests_seconds_count{environment=\"$env\"}[5m])), 0.001) * 100"
        }
      ],
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 2 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "p99 Latency (excl. SSE)",
      "description": "사용자 체감 RED의 D. SSE long-poll 제외해야 의미. SLO: < 300ms.",
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{environment=\"$env\", uri!~\"/actuator.*|.*sse.*\"}[5m])))"
        }
      ],
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.3 },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "JVM Heap %",
      "description": "Saturation. > 85% 5분 지속이면 OOM 위험. swap 1GB가 안전망.",
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jvm_memory_used_bytes{environment=\"$env\", area=\"heap\"}) / sum(jvm_memory_max_bytes{environment=\"$env\", area=\"heap\"}) * 100"
        }
      ],
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 85 }
            ]
          }
        }
      }
    },

    {
      "type": "row",
      "title": "📡 Request Flow — 어디가 바쁘고 어디가 실패하나",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "collapsed": false,
      "id": 101
    },
    {
      "type": "timeseries",
      "title": "RPS by Endpoint",
      "description": "endpoint별 RPS 추세. actuator/sse 제외.",
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "id": 5,
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (uri) (rate(http_server_requests_seconds_count{environment=\"$env\", uri!~\"/actuator.*|.*sse.*\"}[1m]))",
          "legendFormat": "{{uri}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "never" }
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      }
    },
    {
      "type": "timeseries",
      "title": "Status Code Distribution",
      "description": "2xx/4xx/5xx 시간별 stack. 에러 추세 한눈에.",
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "id": 6,
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{environment=\"$env\", uri!~\"/actuator.*\"}[1m]))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "bars", "fillOpacity": 80, "lineWidth": 0, "stacking": { "mode": "normal" } }
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] }
      }
    },
    {
      "type": "timeseries",
      "title": "Latency Percentiles (p50/p95/p99, excl. SSE)",
      "description": "분위수 3개 함께 — 중간값과 outlier 격차 비교.",
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 15 },
      "id": 7,
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_requests_seconds_bucket{environment=\"$env\", uri!~\"/actuator.*|.*sse.*\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{environment=\"$env\", uri!~\"/actuator.*|.*sse.*\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{environment=\"$env\", uri!~\"/actuator.*|.*sse.*\"}[5m])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "custom": { "drawStyle": "line", "fillOpacity": 0, "lineWidth": 2, "showPoints": "never" }
        }
      }
    },

    {
      "type": "row",
      "title": "🗄 Database & JVM — 자원 포화도",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "collapsed": false,
      "id": 102
    },
    {
      "type": "timeseries",
      "title": "HikariCP Connection Pool",
      "description": "active/idle/pending. pending > 0이면 풀 부족.",
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "id": 8,
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_active{environment=\"$env\"}",
          "legendFormat": "active"
        },
        {
          "refId": "B",
          "expr": "hikaricp_connections_idle{environment=\"$env\"}",
          "legendFormat": "idle"
        },
        {
          "refId": "C",
          "expr": "hikaricp_connections_pending{environment=\"$env\"}",
          "legendFormat": "pending ⚠️"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 1, "stacking": { "mode": "none" } }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "JVM Heap Used vs Max",
      "description": "heap 메모리 추세. swap 사용 시작되면 위험.",
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "id": 9,
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jvm_memory_used_bytes{environment=\"$env\", area=\"heap\"})",
          "legendFormat": "used"
        },
        {
          "refId": "B",
          "expr": "sum(jvm_memory_committed_bytes{environment=\"$env\", area=\"heap\"})",
          "legendFormat": "committed"
        },
        {
          "refId": "C",
          "expr": "sum(jvm_memory_max_bytes{environment=\"$env\", area=\"heap\"})",
          "legendFormat": "max"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1 }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "GC Pause Time / sec",
      "description": "GC가 latency에 영향 주는 정도. 0.1초/초 넘으면 GC 압박.",
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "id": 10,
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cause, action) (rate(jvm_gc_pause_seconds_sum{environment=\"$env\"}[1m]))",
          "legendFormat": "{{cause}} / {{action}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "custom": { "drawStyle": "line", "fillOpacity": 30, "lineWidth": 1, "stacking": { "mode": "normal" } }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "JVM Threads",
      "description": "live / daemon / peak — 스레드 누수 또는 폭증 감지.",
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "id": 11,
      "targets": [
        {
          "refId": "A",
          "expr": "jvm_threads_live_threads{environment=\"$env\"}",
          "legendFormat": "live"
        },
        {
          "refId": "B",
          "expr": "jvm_threads_daemon_threads{environment=\"$env\"}",
          "legendFormat": "daemon"
        },
        {
          "refId": "C",
          "expr": "jvm_threads_peak_threads{environment=\"$env\"}",
          "legendFormat": "peak"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "fillOpacity": 0, "lineWidth": 1 }
        }
      }
    },

    {
      "type": "row",
      "title": "🖥 System — 호스트 자원",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 40 },
      "collapsed": false,
      "id": 103
    },
    {
      "type": "timeseries",
      "title": "CPU Usage %",
      "description": "1분 평균 CPU. 80% 넘으면 한계 근접.",
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 41 },
      "id": 12,
      "targets": [
        {
          "refId": "A",
          "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{environment=\"$env\", mode=\"idle\"}[1m])) * 100)",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "drawStyle": "line", "fillOpacity": 30, "lineWidth": 1 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Memory Usage",
      "description": "Used vs Available. Swap 사용 시작되면 압박 시작.",
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 41 },
      "id": 13,
      "targets": [
        {
          "refId": "A",
          "expr": "node_memory_MemTotal_bytes{environment=\"$env\"} - node_memory_MemAvailable_bytes{environment=\"$env\"}",
          "legendFormat": "used"
        },
        {
          "refId": "B",
          "expr": "node_memory_MemAvailable_bytes{environment=\"$env\"}",
          "legendFormat": "available"
        },
        {
          "refId": "C",
          "expr": "node_memory_SwapTotal_bytes{environment=\"$env\"} - node_memory_SwapFree_bytes{environment=\"$env\"}",
          "legendFormat": "swap used"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "drawStyle": "line", "fillOpacity": 30, "lineWidth": 1, "stacking": { "mode": "none" } }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Disk Usage % (root /)",
      "description": "디스크 충만. 90% 넘으면 알람. 우리는 CI에서 24h 이상 ECR 이미지 자동 prune.",
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 49 },
      "id": 14,
      "targets": [
        {
          "refId": "A",
          "expr": "(1 - node_filesystem_avail_bytes{environment=\"$env\", mountpoint=\"/\", fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{environment=\"$env\", mountpoint=\"/\"}) * 100",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "drawStyle": "line", "fillOpacity": 30, "lineWidth": 1 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 75 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Network Traffic (eth0)",
      "description": "Rx/Tx. 배포 시 ECR pull spike 보임. 다른 spike는 부하 테스트.",
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 49 },
      "id": 15,
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_network_receive_bytes_total{environment=\"$env\", device=\"eth0\"}[1m])",
          "legendFormat": "Rx eth0"
        },
        {
          "refId": "B",
          "expr": "rate(node_network_transmit_bytes_total{environment=\"$env\", device=\"eth0\"}[1m]) * -1",
          "legendFormat": "Tx eth0"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 1 }
        }
      }
    }
  ]
}
