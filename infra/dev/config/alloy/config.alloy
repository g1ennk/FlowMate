// ── Metrics: Spring Boot Actuator ──────────────────────────────
prometheus.scrape "backend" {
  targets = [{
    "__address__"      = "backend:8080",
    "__metrics_path__" = "/actuator/prometheus",
  }]
  scrape_interval = "15s"
  forward_to      = [prometheus.relabel.backend.receiver]
}

prometheus.relabel "backend" {
  rule {
    target_label = "instance"
    replacement  = "flowmate-backend-dev"
  }
  rule {
    target_label = "environment"
    replacement  = "dev"
  }

  // ── Drop unused backend metrics (cardinality 절감) ──
  // active request 추적은 안 쓰고, p99 latency만 봄 → bucket만으로 부족 X
  rule {
    source_labels = ["__name__"]
    regex         = "http_server_requests_active_seconds_.*"
    action        = "drop"
  }
  // JVM 디테일 메트릭 — 거의 안 봄
  rule {
    source_labels = ["__name__"]
    regex         = "jvm_buffer_.*|jvm_classes_.*|jvm_compilation_.*"
    action        = "drop"
  }
  // Spring ThreadPoolTaskExecutor — 우리 안 씀 (기본값 Integer.MAX)
  rule {
    source_labels = ["__name__"]
    regex         = "executor_.*"
    action        = "drop"
  }
  // logback 로그 카운터 — 로그는 Loki로 다 가니까 메트릭 중복
  rule {
    source_labels = ["__name__"]
    regex         = "logback_events_total"
    action        = "drop"
  }

  forward_to = [prometheus.remote_write.grafana_cloud.receiver]
}

// ── Metrics: System (node-exporter 대체) ──────────────────────
// 핵심 collector 10개만 활성 (기본 40+개에서 축소)
prometheus.exporter.unix "host" {
  procfs_path = "/host/proc"
  sysfs_path  = "/host/sys"
  rootfs_path = "/rootfs"

  set_collectors = ["cpu", "diskstats", "filesystem", "loadavg", "meminfo",
                    "netdev", "stat", "vmstat", "uname", "time"]

  filesystem {
    mount_points_exclude = "^/(sys|proc|dev|host|etc)($|/)"
  }
}

prometheus.scrape "host" {
  targets         = prometheus.exporter.unix.host.targets
  scrape_interval = "15s"
  forward_to      = [prometheus.relabel.host.receiver]
}

prometheus.relabel "host" {
  rule {
    target_label = "instance"
    replacement  = "flowmate-host-dev"
  }
  rule {
    target_label = "environment"
    replacement  = "dev"
  }

  // ── Drop unused host metrics (cardinality 절감) ──
  // scrape 자체의 메타 메트릭 — 안 봄
  rule {
    source_labels = ["__name__"]
    regex         = "node_scrape_collector_.*"
    action        = "drop"
  }
  // 가상 네트워크 인터페이스 (Docker veth, bridge) — 메인 eth0/lo만 유지
  rule {
    source_labels = ["device"]
    regex         = "(veth.*|docker.*|br-.*)"
    action        = "drop"
  }

  forward_to = [prometheus.remote_write.grafana_cloud.receiver]
}

// ── Remote Write → Grafana Cloud Mimir ────────────────────────
prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_CLOUD_METRICS_URL")
    basic_auth {
      username = sys.env("GRAFANA_CLOUD_METRICS_USER")
      password = sys.env("GRAFANA_CLOUD_API_KEY")
    }
  }
}

// ── Logs: Docker 컨테이너 → Grafana Cloud Loki ─────────────────
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  // 컨테이너 이름에서 service 추출: "/flowmate-backend-dev" → "backend"
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/flowmate-([a-z-]+)-(dev|prod)"
    target_label  = "service"
    replacement   = "$1"
  }

  // 환경 라벨
  rule {
    target_label = "environment"
    replacement  = "dev"
  }

  // 컨테이너 풀네임도 보존 (디버그용)
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
    replacement   = "$1"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  forward_to = [loki.process.parse_json.receiver]
}

// JSON 로그 파싱: level은 라벨로, trace_id는 필드로 (cardinality 보호)
loki.process "parse_json" {
  forward_to = [loki.write.grafana_cloud.receiver]

  // ① 24시간 넘은 timestamp drop (Loki 400 timestamp_too_old 방지)
  //    배경: EC2 stop/start 후 alloy 재시작 시 docker journal의 옛 로그를
  //          처음부터 read → 옛 timestamp가 batch에 섞여 Loki가 batch 전체
  //          reject → 신규 로그까지 drop되는 사고 발생
  //    EC2 stop/start: prod는 매일 자정~7AM 정지, dev도 유사
  stage.drop {
    older_than          = "24h"
    drop_counter_reason = "older_than"
  }

  stage.json {
    expressions = {
      level     = "level",
      trace_id  = "trace_id",
      logger    = "logger",
    }
  }

  // level만 라벨로 (trace_id는 high cardinality라 라벨 X, 필드 검색)
  stage.labels {
    values = { level = "" }
  }
}

loki.write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_CLOUD_LOGS_URL")
    basic_auth {
      username = sys.env("GRAFANA_CLOUD_LOGS_USER")
      password = sys.env("GRAFANA_CLOUD_API_KEY")
    }
  }
}

// ── Traces: OTLP → Grafana Cloud Tempo ────────────────────────
otelcol.receiver.otlp "default" {
  grpc { endpoint = "0.0.0.0:4317" }
  http { endpoint = "0.0.0.0:4318" }
  output {
    traces = [otelcol.exporter.otlp.grafana_cloud.input]
  }
}

otelcol.exporter.otlp "grafana_cloud" {
  client {
    endpoint = sys.env("GRAFANA_CLOUD_TEMPO_ENDPOINT")
    auth     = otelcol.auth.basic.grafana_cloud.handler
  }
}

otelcol.auth.basic "grafana_cloud" {
  username = sys.env("GRAFANA_CLOUD_TEMPO_USER")
  password = sys.env("GRAFANA_CLOUD_API_KEY")
}
